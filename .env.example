# GEMINI_API_KEY: Required for AI generation (Node dev server reads this file; on Cloudflare it is a Worker secret).
GEMINI_API_KEY="MY_GEMINI_API_KEY"


# GEMINI_MODEL: model ID to use (default gemini-3.6-flash). Checked against models.list at boot.
GEMINI_MODEL="gemini-3.6-flash"

# BIOSOP_DB_PATH: SQLite file for protocols, versions, signatures, audit log (default ./data/biosop.db)
BIOSOP_DB_PATH="./data/biosop.db"

# BIOSOP_API_TOKEN: if set, AI endpoints require "Authorization: Bearer <token>". Strongly recommended for any public deployment.
# BIOSOP_API_TOKEN=""

# AI_RATE_LIMIT_PER_10MIN: per-IP request cap on AI endpoints (default 30)
AI_RATE_LIMIT_PER_10MIN=30

# NCBI_API_KEY: optional; raises PubMed rate limit from 3 to 10 req/s
# NCBI_API_KEY=""

# LITERATURE_CONTACT_EMAIL: sent in User-Agent to Crossref (polite pool). Use a real address.
LITERATURE_CONTACT_EMAIL="you@example.org"
